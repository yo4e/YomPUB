[
  {
    "name": "ordinary text",
    "body": "Hello, 世界.",
    "inline": [
      {
        "type": "text",
        "value": "Hello, 世界."
      }
    ]
  },
  {
    "name": "logical multilingual Unicode preserved",
    "body": "é が 👨‍👩‍👧‍👦 العربية हि‍न्दी ไทย",
    "inline": [
      {
        "type": "text",
        "value": "é が 👨‍👩‍👧‍👦 العربية हि‍न्दी ไทย"
      }
    ]
  },
  {
    "name": "ruby in middle of prose",
    "body": "空は｜青空《あおぞら》。",
    "inline": [
      {
        "type": "text",
        "value": "空は"
      },
      {
        "type": "ruby",
        "base": "青空",
        "annotation": "あおぞら"
      },
      {
        "type": "text",
        "value": "。"
      }
    ]
  },
  {
    "name": "adjacent group ruby",
    "body": "｜海《うみ》｜風《かぜ》",
    "inline": [
      {
        "type": "ruby",
        "base": "海",
        "annotation": "うみ"
      },
      {
        "type": "ruby",
        "base": "風",
        "annotation": "かぜ"
      }
    ]
  },
  {
    "name": "escaped ruby opener stays literal",
    "body": "\\｜海《うみ》",
    "inline": [
      {
        "type": "text",
        "value": "｜海《うみ》"
      }
    ]
  },
  {
    "name": "entity ruby opener stays literal",
    "body": "&#xff5c;海《うみ》",
    "inline": [
      {
        "type": "text",
        "value": "｜海《うみ》"
      }
    ]
  },
  {
    "name": "ruby field escapes",
    "body": "｜a\\《b《c\\》d》",
    "inline": [
      {
        "type": "ruby",
        "base": "a《b",
        "annotation": "c》d"
      }
    ]
  },
  {
    "name": "ruby fields decode entities once",
    "body": "｜A&amp;B《A&#124;B》",
    "inline": [
      {
        "type": "ruby",
        "base": "A&B",
        "annotation": "A|B"
      }
    ]
  },
  {
    "name": "escaped ampersand is not redecoded",
    "body": "｜\\&amp;《&amp;amp;》",
    "inline": [
      {
        "type": "ruby",
        "base": "&amp;",
        "annotation": "&amp;"
      }
    ]
  },
  {
    "name": "ruby fields are atomic",
    "body": "｜*海*《[うみ]》",
    "inline": [
      {
        "type": "ruby",
        "base": "*海*",
        "annotation": "[うみ]"
      }
    ]
  },
  {
    "name": "ruby surrounded by emphasis",
    "body": "*｜海《うみ》*",
    "inline": [
      {
        "type": "emphasis",
        "children": [
          {
            "type": "ruby",
            "base": "海",
            "annotation": "うみ"
          }
        ]
      }
    ]
  },
  {
    "name": "ruby notation in code is code",
    "body": "`｜海《うみ》`",
    "inline": [
      {
        "type": "code",
        "value": "｜海《うみ》"
      }
    ]
  },
  {
    "name": "fixed isolated run",
    "body": "اسم {{en|ltr|A-12 (2026)}}، هنا.",
    "inline": [
      {
        "type": "text",
        "value": "اسم "
      },
      {
        "type": "span",
        "lang": "en",
        "direction": "ltr",
        "value": "A-12 (2026)"
      },
      {
        "type": "text",
        "value": "، هنا."
      }
    ]
  },
  {
    "name": "RTL and auto runs",
    "body": "{{he|rtl|שלום}} {{und|auto|42}}",
    "inline": [
      {
        "type": "span",
        "lang": "he",
        "direction": "rtl",
        "value": "שלום"
      },
      {
        "type": "text",
        "value": " "
      },
      {
        "type": "span",
        "lang": "und",
        "direction": "auto",
        "value": "42"
      }
    ]
  },
  {
    "name": "run escapes and entities",
    "body": "{{en|ltr|a\\|b\\}\\} &amp;}}",
    "inline": [
      {
        "type": "span",
        "lang": "en",
        "direction": "ltr",
        "value": "a|b}} &"
      }
    ]
  },
  {
    "name": "run fields are atomic",
    "body": "{{ja|ltr|｜海《うみ》 *x*}}",
    "inline": [
      {
        "type": "span",
        "lang": "ja",
        "direction": "ltr",
        "value": "｜海《うみ》 *x*"
      }
    ]
  },
  {
    "name": "escaped run opener",
    "body": "\\{{en|ltr|x}}",
    "inline": [
      {
        "type": "text",
        "value": "{{en|ltr|x}}"
      }
    ]
  },
  {
    "name": "entity run opener",
    "body": "&#123;{en|ltr|x}}",
    "inline": [
      {
        "type": "text",
        "value": "{{en|ltr|x}}"
      }
    ]
  },
  {
    "name": "run in link label",
    "body": "[{{en|ltr|A}}](https://example.org/)",
    "inline": [
      {
        "type": "link",
        "href": "https://example.org/",
        "title": "",
        "children": [
          {
            "type": "span",
            "lang": "en",
            "direction": "ltr",
            "value": "A"
          }
        ]
      }
    ]
  },
  {
    "name": "extension marker in destination stays destination",
    "body": "[x](https://example.org/｜海《うみ》)",
    "inline": [
      {
        "type": "link",
        "href": "https://example.org/｜海《うみ》",
        "title": "",
        "children": [
          {
            "type": "text",
            "value": "x"
          }
        ]
      }
    ]
  },
  {
    "name": "link title is literal",
    "body": "[x](https://example.org/ \"{{oops}}\")",
    "inline": [
      {
        "type": "link",
        "href": "https://example.org/",
        "title": "{{oops}}",
        "children": [
          {
            "type": "text",
            "value": "x"
          }
        ]
      }
    ]
  },
  {
    "name": "soft and hard breaks distinct",
    "body": "a\nb  \nc\\\nd",
    "inline": [
      {
        "type": "text",
        "value": "a"
      },
      {
        "type": "softBreak"
      },
      {
        "type": "text",
        "value": "b"
      },
      {
        "type": "hardBreak"
      },
      {
        "type": "text",
        "value": "c"
      },
      {
        "type": "hardBreak"
      },
      {
        "type": "text",
        "value": "d"
      }
    ]
  },
  {
    "name": "image alt flattens supported markup",
    "body": "![*a* `b`](assets/a.png \"A\")",
    "inline": [
      {
        "type": "image",
        "src": "assets/a.png",
        "alt": "a b",
        "title": "A"
      }
    ]
  },
  {
    "name": "decorative image alt",
    "body": "![](assets/a.png)",
    "inline": [
      {
        "type": "image",
        "src": "assets/a.png",
        "alt": "",
        "title": ""
      }
    ]
  },
  {
    "name": "bare URL not auto-linked",
    "body": "https://example.org/",
    "inline": [
      {
        "type": "text",
        "value": "https://example.org/"
      }
    ]
  },
  {
    "name": "unsupported strikethrough is ordinary text",
    "body": "~~word~~",
    "inline": [
      {
        "type": "text",
        "value": "~~word~~"
      }
    ]
  },
  {
    "name": "escaped HTML is text",
    "body": "&lt;script&gt;x&lt;/script&gt;",
